# Server
PORT=8787
HOST=127.0.0.1

# Analysis pipeline
MAX_REVIEWS=300
MODEL_MAX_REVIEWS=160
CLASSIFY_BATCH_SIZE=24
MIN_FINDING_SUPPORT=3
LLM_TIMEOUT_MS=300000
LLM_MAX_RETRIES=3
REQUEST_DELAY_MS=1100
COLLECTION_SOFT_BLOCK_RETRIES=3
COLLECTION_SOFT_BLOCK_DELAY_MS=8000

# LLM provider: ollama | openai | mock | off
LLM_PROVIDER=ollama

# Ollama local runtime
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=DeepSeek-R1:7b
OLLAMA_NUM_CTX=16384

# OpenAI-compatible API (OpenAI, DeepSeek, Moonshot, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.2
